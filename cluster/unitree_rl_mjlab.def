Bootstrap: localimage
From: /data/cluster/users/mattes/26-MOGB/sgrl-ber1.sif

# No %post: BER1 cannot run one (apparmor blocks the unprivileged user namespace),
# so the venv is created by cluster/build_sif.sh before the build and only copied
# in here. The base image provides Python 3.12 at /opt/uv-python, git, EGL and ffmpeg.
#
# Dependencies are baked in from uv.lock; the code is not. At runtime the repo is
# bind-mounted at /work/code and put on PYTHONPATH, so code edits need no rebuild.
# Rebuild only when pyproject.toml / uv.lock change.

%files
    unitree_venv /opt/unitree_venv

%environment
    export PATH=/opt/unitree_venv/bin:$PATH
    export VIRTUAL_ENV=/opt/unitree_venv
    export PYTHONPATH=/work/code
    export PYTHONUNBUFFERED=1
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl

%labels
    Project unitree_rl_mjlab
    Description "unitree_rl_mjlab training env: deps baked in, code bind-mounted at /work/code"
